# Phase 1 environment variables for local development.
# Copy to .env.local and populate before running scripts/demo_db.py.

# Redis connection (defaults match config/redis_memory.conf)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_DB=0
REDIS_POOL_MAX_CONN=10
REDIS_SOCKET_TIMEOUT=2.0
REDIS_CONNECT_TIMEOUT=2.0

# In OCP these map to the in-cluster service names:
# REDIS_HOST=redis-svc
